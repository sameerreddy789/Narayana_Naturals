rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function verifiedIndianPhone() {
      return signedIn() && request.auth.token.get('phone_number', '') is string
        && request.auth.token.get('phone_number', '').matches('^\\+91[6-9][0-9]{9}$');
    }
    function validAddress(data) {
      return data.keys().hasAll(['name', 'phone', 'street', 'city', 'pin'])
        && data.keys().hasOnly(['name', 'phone', 'street', 'city', 'pin'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.matches('^[6-9][0-9]{9}$')
        && data.street is string && data.street.size() >= 5 && data.street.size() <= 300
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 100
        && data.pin is string && data.pin.matches('^[1-9][0-9]{5}$');
    }
    function validLine(line) {
      return line is map && line.keys().hasAll(['id', 'quantity']) && line.keys().hasOnly(['id', 'quantity'])
        && line.id in ['1l', '2l', '5l'] && line.quantity is int && line.quantity >= 1 && line.quantity <= 20;
    }
    function validCartLines(lines) {
      return lines is list && lines.size() <= 3
        && (lines.size() < 1 || validLine(lines[0]))
        && (lines.size() < 2 || (validLine(lines[1]) && lines[0].id != lines[1].id))
        && (lines.size() < 3 || (validLine(lines[2]) && lines[0].id != lines[2].id && lines[1].id != lines[2].id));
    }
    function validPage(pages, index) {
      return pages.size() <= index || (pages[index] is string && pages[index].size() >= 1 && pages[index].size() <= 64);
    }
    function validPages(pages) {
      return pages is list && pages.size() <= 20 && pages.toSet().size() == pages.size()
        && validPage(pages, 0) && validPage(pages, 1) && validPage(pages, 2) && validPage(pages, 3)
        && validPage(pages, 4) && validPage(pages, 5) && validPage(pages, 6) && validPage(pages, 7)
        && validPage(pages, 8) && validPage(pages, 9) && validPage(pages, 10) && validPage(pages, 11)
        && validPage(pages, 12) && validPage(pages, 13) && validPage(pages, 14) && validPage(pages, 15)
        && validPage(pages, 16) && validPage(pages, 17) && validPage(pages, 18) && validPage(pages, 19);
    }

    match /products/{productId} {
      allow read: if resource.data.published == true;
      allow write: if false;
      match /variants/{id} {
        allow read: if get(/databases/$(database)/documents/products/$(productId)).data.published == true;
        allow write: if false;
      }
    }
    match /publicContent/{id} { allow read: if id == 'storefront'; allow write: if false; }
    match /deliveryRules/{pin} {
      allow get: if pin.matches('^[1-9][0-9]{5}$') && resource.data.enabled == true;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get, delete: if owns(uid);
      allow list: if false;
      allow create, update: if owns(uid) && verifiedIndianPhone()
        && request.resource.data.keys().hasAll(['displayName', 'phoneNumber', 'language'])
        && request.resource.data.keys().hasOnly(['displayName', 'phoneNumber', 'language'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && request.resource.data.language in ['en', 'te'];
      match /addresses/{addressId} {
        allow read, delete: if owns(uid) && addressId == 'default';
        allow create, update: if owns(uid) && addressId == 'default' && validAddress(request.resource.data);
      }
      match /onboarding/{version} {
        allow read, delete: if owns(uid) && version in ['web-v1', 'android-v1'];
        allow create, update: if owns(uid) && version in ['web-v1', 'android-v1']
          && request.resource.data.keys().hasAll(['welcomeSeen', 'skipped', 'dismissedPages'])
          && request.resource.data.keys().hasOnly(['welcomeSeen', 'skipped', 'dismissedPages'])
          && request.resource.data.welcomeSeen is bool && request.resource.data.skipped is bool
          && validPages(request.resource.data.dismissedPages);
      }
    }
    match /carts/{uid} {
      allow get, delete: if owns(uid);
      allow list: if false;
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['lines', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['lines', 'updatedAt'])
        && validCartLines(request.resource.data.lines)
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time;
    }
    match /orders/{orderId} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if request.query.limit != null && request.query.limit <= 100
        && (isAdmin() || (signedIn() && resource.data.uid == request.auth.uid));
      allow write: if false;
    }
    // Private quotes, retry keys, rate limits, inventory and all unknown paths are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
