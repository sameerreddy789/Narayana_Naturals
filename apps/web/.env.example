# Copy to apps/web/.env.local, then restart dev or rebuild.
# Public client configuration only. Never put Admin/service-account keys here.
# Public NEXT_PUBLIC values are fixed at build time; rebuild after changing them.
# Firebase is the default. Explicit demo/emulator modes are for local tests only.
NEXT_PUBLIC_BACKEND_MODE=firebase
# production reads commerce; private-draft reads commerceDraft and accepts only
# labelled demonstration records. Invalid stage names fail configuration checks.
NEXT_PUBLIC_STORE_STAGE=production
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# WEB app configuration, not the Android app's API key/app ID.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=narayananaturals-6b5aa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=narayananaturals-6b5aa
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://narayananaturals-6b5aa-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=narayananaturals-6b5aa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=255355716241
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emulator mode defaults to http://127.0.0.1:5002. Firebase mode requires
# the separately hosted Node commerce API's HTTPS base URL.
NEXT_PUBLIC_COMMERCE_API_URL=https://narayana-naturals-api.onrender.com

# Cloud API always requires a real Firebase App Check token. Production uses
# this web app's registered reCAPTCHA v3 public site key.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# For an invited private test only: select private-draft and set debug=true.
# The SDK generates a separate debug token for each browser, visible in its
# developer console. The owner must register that token for this Firebase web
# app. The debug exchange works without a CAPTCHA site key in this explicit
# private configuration. Never paste a shared debug token into this file.
# Debug=true is rejected outside Firebase private-draft mode.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=false

# Enable Firebase Authentication Email/Password (no SMS/billing required).
# Local emulator fixtures are created by npm run emulators:seed. They do not
# access the real project. Clear COMMERCE_API_URL to use its loopback default
# when selecting emulator mode.
# Private account access requires an owner-provisioned tester:true or admin:true
# claim. Creating an email account does not grant that access.
# A trusted Admin custom claim {admin:true}, not a profile field, grants owner access.
