# Local preview requires the demo Auth and Realtime Database emulators.
BACKEND_MODE=emulator
GCLOUD_PROJECT=demo-narayana-naturals
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
PORT=5002
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live hosting: choose BACKEND_MODE=firebase, GCLOUD_PROJECT=narayananaturals-6b5aa
# and DATABASE_URL=https://narayananaturals-6b5aa-default-rtdb.firebaseio.com.
# Remove both emulator variables. Use Application Default Credentials on the
# host, or an ignored GOOGLE_APPLICATION_CREDENTIALS file supplied by the owner.
# A TLS reverse proxy, a real ALLOWED_ORIGINS allowlist and Firebase App Check
# configuration are required. Live API requests always require App Check.
