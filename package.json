{
  "name": "narayana-naturals",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "backend:install": "npm ci --prefix backend --workspaces=false",
    "backend:build": "npm run build --prefix backend",
    "backend:test": "npm run test --prefix backend",
    "backend:start": "node --env-file-if-exists=backend/.env backend/lib/src/index.js",
    "emulators": "node scripts/start-emulators.mjs",
    "emulators:save": "firebase emulators:export .local-run/rtdb-emulator-data --force --project demo-narayana-naturals",
    "emulators:seed": "npm run seed:emulator --prefix backend",
    "test:integration": "firebase emulators:exec --config firebase.test.json --project demo-narayana-naturals --only auth,database \"npm --prefix backend run test:integration\""
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.6",
    "firebase-tools": "^15.34.0"
  }
}
