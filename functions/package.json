    "@types/node": "^22.18.0",
    "firebase": "^12.19.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
