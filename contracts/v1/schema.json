{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:narayana-naturals:commerce:v1",
  "title": "Narayana Naturals Realtime Database commerce v1",
  "$comment": "Select the named definition for each HTTP payload. Requests/results use a data envelope; timestamps are epoch milliseconds. Ownership, distinct IDs, consistent litres and arithmetic are enforced by backend/src/model.ts and commerce.ts.",
  "$defs": {
    "variantId": {
      "type": "string",
      "enum": [
        "1l",
        "2l",
        "5l"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "money": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000,
      "description": "Server time in epoch milliseconds."
    },
    "bilingual": {
      "type": "object",
      "required": [
        "en",
        "te"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "te": {
          "type": "string"
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "id",
        "quantity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/variantId"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/line"
      },
      "description": "The server also requires distinct variant IDs regardless of quantity."
    },
    "address": {
      "type": "object",
      "required": [
        "name",
        "phone",
        "street",
        "city",
        "pin"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "pattern": "^[6-9][0-9]{9}$",
          "description": "Delivery contact, not an Auth phone identity."
        },
        "street": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "pin": {
          "type": "string",
          "pattern": "^[1-9][0-9]{5}$"
        }
      }
    },
    "orderLine": {
      "type": "object",
      "required": [
        "id",
        "quantity",
        "litres",
        "unitPricePaise"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/variantId"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "litres": {
          "type": "integer",
          "enum": [
            1,
            2,
            5
          ]
        },
        "unitPricePaise": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000000
        }
      }
    },
    "quoteRequest": {
      "type": "object",
      "required": [
        "lines",
        "address",
        "channel"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "$ref": "#/$defs/lines"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "channel": {
          "type": "string",
          "enum": [
            "web",
            "android"
          ]
        }
      }
    },
    "quoteResponse": {
      "type": "object",
      "required": [
        "quoteId",
        "subtotalPaise",
        "shippingPaise",
        "totalPaise",
        "codAllowed",
        "estimate",
        "expiresAt",
        "preview",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "quoteId": {
          "$ref": "#/$defs/identifier"
        },
        "subtotalPaise": {
          "$ref": "#/$defs/money"
        },
        "shippingPaise": {
          "$ref": "#/$defs/money"
        },
        "totalPaise": {
          "$ref": "#/$defs/money"
        },
        "codAllowed": {
          "type": "boolean"
        },
        "estimate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "preview": {
          "type": "boolean"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/orderLine"
          }
        }
      }
    },
    "placeCodOrderRequest": {
      "type": "object",
      "required": [
        "quoteId",
        "idempotencyKey"
      ],
      "additionalProperties": false,
      "properties": {
        "quoteId": {
          "$ref": "#/$defs/identifier"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "placeCodOrderResponse": {
      "type": "object",
      "required": [
        "orderId"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "updateVariantRequest": {
      "type": "object",
      "required": [
        "id",
        "pricePaise",
        "stock",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/variantId"
        },
        "pricePaise": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000000
        },
        "stock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "updateVariantResponse": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/variantId"
        }
      }
    },
    "updateOrderStatusRequest": {
      "type": "object",
      "required": [
        "orderId",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "packed",
            "shipped",
            "delivered",
            "cancelled"
          ]
        }
      }
    },
    "updateOrderStatusResponse": {
      "type": "object",
      "required": [
        "orderId",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "packed",
            "shipped",
            "delivered",
            "cancelled"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "displayName",
        "email",
        "language"
      ],
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Must equal the signed-in Firebase Auth token email."
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "te"
          ]
        },
        "phoneNumber": {
          "type": "string",
          "pattern": "^\\+91[6-9][0-9]{9}$"
        }
      }
    },
    "cart": {
      "type": "object",
      "required": [
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "lines": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/line"
          },
          "description": "RTDB omits empty children; missing/null means an empty cart."
        }
      }
    },
    "onboarding": {
      "type": "object",
      "required": [
        "welcomeSeen",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "welcomeSeen": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "dismissedPages": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "description": "Missing/null normalizes to an empty list."
        }
      }
    },
    "order": {
      "type": "object",
      "required": [
        "id",
        "uid",
        "customerPhone",
        "createdAt",
        "lines",
        "address",
        "subtotalPaise",
        "shippingPaise",
        "totalPaise",
        "paymentMethod",
        "paymentStatus",
        "status",
        "channel",
        "preview"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "customerPhone": {
          "type": "string",
          "pattern": "^\\+91[6-9][0-9]{9}$"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/orderLine"
          }
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "subtotalPaise": {
          "$ref": "#/$defs/money"
        },
        "shippingPaise": {
          "$ref": "#/$defs/money"
        },
        "totalPaise": {
          "$ref": "#/$defs/money"
        },
        "paymentMethod": {
          "const": "cod"
        },
        "paymentStatus": {
          "type": "string",
          "enum": [
            "pending_collection",
            "collected",
            "cancelled"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "packed",
            "shipped",
            "delivered",
            "cancelled"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "web",
            "android"
          ]
        },
        "preview": {
          "type": "boolean"
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "required": [
                "nativeCode"
              ],
              "additionalProperties": false,
              "properties": {
                "nativeCode": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
